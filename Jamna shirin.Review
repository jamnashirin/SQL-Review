create table employeee(employeee_id int auto_increment primary key,first_name varchar(50),last_name varchar(50),Salary int,joining_date date,Department varchar(50));

create  table reward(employeee_ref_id int,date_reward date,amount int,foreign key(employeee_ref_id)references employeee(employeee_id));

